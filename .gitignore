# Credential and runtime artifacts — must never be committed
*.credentials.json
auth.json
oauth-accounts/
.active-profile
.quota-cache.json
.login-*
*.tmp
.oauth-switch.*

# Local operator notes for private account labels, machine paths, token history,
# and harness-specific background. This project is open source; keep those notes
# out of GitHub and maintain them in ignored local files instead.
README.local.md
*.local.md
docs/local/
docs/private/

# Agent harness working state. `.claude/worktrees/` holds full checkout copies
# and `settings.local.json` holds machine-local permissions; neither belongs in
# a public repo. A shared `.claude/settings.json` may still be committed.
.claude/worktrees/
.claude/settings.local.json
