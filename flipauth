#!/usr/bin/env bash
set -euo pipefail

# flipauth — OAuth profile switcher for the official Claude Code and Codex CLIs.
# Service is resolved from the invocation name ($0):
#   claude-switch ...       -> service=claude
#   codex-switch  ...       -> service=codex
#   flipauth <svc> ...      -> service=<svc>  (claude|codex)
#
# Platform: Windows WSL only.

PROG="$(basename "$0")"

fail() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

case "$PROG" in
  claude-switch) SERVICE=claude ;;
  codex-switch)  SERVICE=codex ;;
  *)
    SERVICE="${1:-}"
    [[ -n "$SERVICE" ]] || fail "usage: flipauth <claude|codex> <command> [args]"
    shift
    ;;
esac
[[ "$SERVICE" == claude || "$SERVICE" == codex ]] ||
  fail "unknown service '$SERVICE' (expected claude or codex)"

# Index-aligned arrays describe the managed runtime files:
#   ACTIVE[i]   absolute path of the live file
#   SUFFIX[i]   saved-profile filename suffix (profile file = <name>.<suffix>)
#   REQUIRED[i] "yes" if the live file must exist to save, "no" if optional
declare -a ACTIVE SUFFIX REQUIRED

if [[ "$SERVICE" == claude ]]; then
  DIR="${CLAUDE_SWITCH_CLAUDE_DIR:-$HOME/.claude}"
  STATE_DIR="${CLAUDE_SWITCH_STATE_DIR:-$DIR/oauth-accounts}"
  ACTIVE=( "${CLAUDE_SWITCH_CREDENTIALS_FILE:-$DIR/.credentials.json}" )
  SUFFIX=( "credentials.json" )
  REQUIRED=( "yes" )
  LABEL="Claude"
else
  DIR="${CODEX_SWITCH_CODEX_DIR:-$HOME/.codex}"
  STATE_DIR="${CODEX_SWITCH_STATE_DIR:-$DIR/oauth-accounts}"
  ACTIVE=( "${CODEX_SWITCH_AUTH_FILE:-$DIR/auth.json}" "${CODEX_SWITCH_CREDENTIALS_FILE:-$DIR/.credentials.json}" )
  SUFFIX=( "auth.json" "credentials.json" )
  REQUIRED=( "yes" "no" )
  LABEL="Codex"
fi

ACTIVE_MARKER="$STATE_DIR/.active-profile"
# Claude-only: last successful /api/oauth/usage sample per profile. Quota-shaped
# fields only — never tokens, headers, or unrelated response fields.
QUOTA_CACHE="$STATE_DIR/.quota-cache.json"
QUOTA_CACHE_SCHEMA=1
PS_BIN="${FLIPAUTH_PS_BIN:-ps}"
HERDR_BIN="${FLIPAUTH_HERDR_BIN:-herdr}"
SWITCH_STOP_TIMEOUT="${FLIPAUTH_SWITCH_STOP_TIMEOUT:-8}"

usage() {
  cat <<USAGE
Usage:
  $PROG save <profile>
  $PROG <profile>
  $PROG status [--json]
  $PROG doctor
USAGE
  printf '  %s quota [profile]\n' "$PROG"
  [[ "$SERVICE" == claude ]] && printf '  %s observe            (reads a statusLine JSON payload on stdin)\n' "$PROG"
  [[ "$SERVICE" == claude ]] && printf '  %s login <profile> [claude auth login options]\n' "$PROG"
  return 0
}

validate_profile_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] ||
    fail "profile names must use letters, digits, underscores, or hyphens"
}

profile_path() { printf '%s/%s.%s\n' "$STATE_DIR" "$1" "${SUFFIX[$2]}"; }

ensure_state_dir() { mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"; }

validate_json_object() {
  python3 - "$1" <<'PY'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
try:
    payload = json.loads(p.read_text(encoding="utf-8"))
except FileNotFoundError:
    raise SystemExit(f"missing credentials file: {p}")
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"invalid credentials file {p}: {exc}")
if not isinstance(payload, dict):
    raise SystemExit(f"unexpected credentials shape in {p}: expected object")
PY
}

validate_claude_credentials() {
  python3 - "$1" <<'PY'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
try:
    payload = json.loads(p.read_text(encoding="utf-8"))
except FileNotFoundError:
    raise SystemExit(f"missing credentials file: {p}")
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"invalid credentials file {p}: {exc}")
if not isinstance(payload, dict):
    raise SystemExit(f"unexpected credentials shape in {p}: expected object")
if "claudeAiOauth" not in payload:
    raise SystemExit(f"unexpected credentials shape in {p}: expected claudeAiOauth")
if not isinstance(payload["claudeAiOauth"], dict):
    raise SystemExit(f"unexpected claudeAiOauth value in {p}: expected an object")
PY
}

validate_file() {
  if [[ "$SERVICE" == claude ]]; then validate_claude_credentials "$1"; else validate_json_object "$1"; fi
}

atomic_copy() {
  local src="$1" dst="$2" dir tmp
  dir="$(dirname "$dst")"; mkdir -p "$dir"; umask 077
  tmp="$(mktemp "$dir/.oauth-switch.XXXXXX")"
  if ! install -m 600 "$src" "$tmp"; then rm -f "$tmp"; return 1; fi
  mv -f "$tmp" "$dst"; chmod 600 "$dst"
}

write_active_marker() {
  local tmp; umask 077
  tmp="$(mktemp "$STATE_DIR/.active-profile.XXXXXX")"
  printf '%s\n' "$1" > "$tmp"; mv -f "$tmp" "$ACTIVE_MARKER"; chmod 600 "$ACTIVE_MARKER"
}

read_active_marker() {
  local p
  [[ -f "$ACTIVE_MARKER" ]] || return 1
  IFS= read -r p < "$ACTIVE_MARKER" || return 1
  validate_profile_name "$p"; printf '%s\n' "$p"
}

validate_active() {
  local i
  for i in "${!ACTIVE[@]}"; do
    if [[ "${REQUIRED[$i]}" == yes ]]; then validate_file "${ACTIVE[$i]}"
    elif [[ -f "${ACTIVE[$i]}" ]]; then validate_json_object "${ACTIVE[$i]}"; fi
  done
}

validate_profile_files() {
  local i path
  for i in "${!ACTIVE[@]}"; do
    path="$(profile_path "$1" "$i")"
    if [[ "${REQUIRED[$i]}" == yes ]]; then validate_file "$path"
    elif [[ -f "$path" ]]; then validate_json_object "$path"; fi
  done
}

save_active_into() {
  local i path
  for i in "${!ACTIVE[@]}"; do
    if [[ -f "${ACTIVE[$i]}" ]]; then
      path="$(profile_path "$1" "$i")"
      atomic_copy "${ACTIVE[$i]}" "$path"
    elif [[ "${REQUIRED[$i]}" == yes ]]; then
      fail "required active file disappeared: ${ACTIVE[$i]}"
    fi
  done
}

load_profile_into_active() {
  local i path
  for i in "${!ACTIVE[@]}"; do
    path="$(profile_path "$1" "$i")"
    if [[ -f "$path" ]]; then
      atomic_copy "$path" "${ACTIVE[$i]}"
    elif [[ "${REQUIRED[$i]}" == yes ]]; then
      fail "required profile file disappeared: $path"
    fi
  done
}

# Herdr supplies lifecycle state for panes it owns, but the system process list is
# the final authority.  Only an idle, positively identified matching pane receives
# /exit; every other Claude/Codex process aborts before any credential write.
_service_processes() {
  "$PS_BIN" -eo pid=,ppid=,tty=,comm=,args= 2>/dev/null | python3 -c '
import os, shlex, sys
service = sys.argv[1]
for raw in sys.stdin:
    parts = raw.strip().split(None, 4)
    if len(parts) < 4: continue
    pid, ppid, tty, comm = parts[:4]
    args = parts[4] if len(parts) == 5 else ""
    try: first = os.path.basename(shlex.split(args)[0]) if args else ""
    except ValueError: first = ""
    if comm == service or first == service: print("\t".join((pid, ppid, tty, comm, args)))
' "$SERVICE"
}

_herdr_agents() {
  command -v "$HERDR_BIN" >/dev/null 2>&1 || return 0
  local snapshot
  snapshot="$("$HERDR_BIN" api snapshot 2>/dev/null)" || return 0
  printf '%s' "$snapshot" | python3 -c '
import json, sys
try:
    snap = json.load(sys.stdin)["result"]["snapshot"]
    workspaces = {x.get("workspace_id"): x.get("label", x.get("workspace_id", "?")) for x in snap.get("workspaces", [])}
    tabs = {x.get("tab_id"): x.get("label", x.get("tab_id", "?")) for x in snap.get("tabs", [])}
except Exception: raise SystemExit(0)
for row in snap.get("agents", []):
    if isinstance(row, dict) and row.get("agent") == sys.argv[1]:
        print("\t".join((str(row.get("pane_id", "?")), str(row.get("agent_status", "unknown")),
                         str(workspaces.get(row.get("workspace_id"), row.get("workspace_id", "?"))),
                         str(tabs.get(row.get("tab_id"), row.get("tab_id", "?"))))))
' "$SERVICE"
}

_herdr_pane_service_pids() {
  local pane="$1" info
  info="$("$HERDR_BIN" pane process-info --pane "$pane" 2>/dev/null)" || return 1
  printf '%s' "$info" | python3 -c '
import json, os, sys
try: rows = json.load(sys.stdin)["result"]["process_info"].get("foreground_processes", [])
except Exception: raise SystemExit(1)
for row in rows:
    if not isinstance(row, dict): continue
    argv = row.get("argv")
    first = os.path.basename(argv[0]) if isinstance(argv, list) and argv and isinstance(argv[0], str) else ""
    if row.get("name") == sys.argv[1] or first == sys.argv[1]:
        if isinstance(row.get("pid"), int) and row["pid"] > 0: print(row["pid"])
' "$SERVICE"
}

_print_running_processes() {
  local rows="$1" pid ppid tty comm args
  printf '\n%s is still running outside an idle Herdr pane:\n' "$LABEL" >&2
  while IFS=$'\t' read -r pid ppid tty comm args; do
    [[ -n "$pid" ]] || continue
    printf '  pid: %s  ppid: %s  tty: %s\n  command: %s\n' "$pid" "$ppid" "$tty" "$args" >&2
  done <<<"$rows"
}

ensure_cli_stopped_for_mutation() {
  [[ "$SWITCH_STOP_TIMEOUT" =~ ^[1-9][0-9]*$ ]] && (( SWITCH_STOP_TIMEOUT <= 60 )) || fail "FLIPAUTH_SWITCH_STOP_TIMEOUT must be an integer from 1 to 60"
  local agents pane status workspace tab pids pid known="" rows unmanaged="" i
  agents="$(_herdr_agents)"
  while IFS=$'\t' read -r pane status workspace tab; do
    [[ -n "$pane" ]] || continue
    if [[ "$status" != idle ]]; then
      printf '\nCannot switch %s profile.\n\n%s is still running in Herdr:\n  workspace: %s\n  tab: %s\n  status: %s\n\nNo credentials were modified.\nWait for the task to finish or exit %s first.\n' "$LABEL" "$LABEL" "$workspace" "$tab" "$status" "$SERVICE" >&2
      return 1
    fi
    pids="$(_herdr_pane_service_pids "$pane")" || { printf '\nCannot switch %s profile: Herdr could not inspect idle pane %s.\nNo credentials were modified.\n' "$LABEL" "$pane" >&2; return 1; }
    while IFS= read -r pid; do [[ -n "$pid" ]] && known+=" $pid"; done <<<"$pids"
  done <<<"$agents"
  rows="$(_service_processes)"
  while IFS=$'\t' read -r pid _; do
    [[ -n "$pid" ]] || continue
    [[ " $known " == *" $pid "* ]] || unmanaged+="$(printf '%s\n' "$rows" | awk -F '\t' -v p="$pid" '$1==p {print; exit}')"$'\n'
  done <<<"$rows"
  if [[ -n "$unmanaged" ]]; then _print_running_processes "$unmanaged"; printf 'No credentials were modified. Exit this %s process yourself, then retry.\n' "$SERVICE" >&2; return 1; fi

  # This preserves the pane and its shell.  Sending /exit alone is never accepted as proof.
  while IFS=$'\t' read -r pane status workspace tab; do
    [[ -n "$pane" ]] || continue
    pids="$(_herdr_pane_service_pids "$pane")"; [[ -n "$pids" ]] || continue
    if ! "$HERDR_BIN" pane send-text "$pane" /exit >/dev/null 2>&1 || ! "$HERDR_BIN" pane send-keys "$pane" enter >/dev/null 2>&1; then
      printf '\nCannot switch %s profile: Herdr could not send /exit to %s.\nNo credentials were modified.\n' "$LABEL" "$pane" >&2; return 1
    fi
  done <<<"$agents"
  for ((i = 0; i < SWITCH_STOP_TIMEOUT * 10; i++)); do rows="$(_service_processes)"; [[ -z "$rows" ]] && break; sleep 0.1; done
  if [[ -n "$rows" ]]; then _print_running_processes "$rows"; printf 'Timed out waiting for %s to exit. No credentials were modified.\n' "$SERVICE" >&2; return 1; fi
  agents="$(_herdr_agents)"
  while IFS=$'\t' read -r pane status workspace tab; do
    [[ -n "$pane" ]] || continue
    pids="$(_herdr_pane_service_pids "$pane")" || return 1
    [[ -z "$pids" ]] || { printf '\nCannot switch %s profile: Herdr still reports %s in pane %s.\nNo credentials were modified.\n' "$LABEL" "$SERVICE" "$pane" >&2; return 1; }
  done <<<"$agents"
  rows="$(_service_processes)"; [[ -z "$rows" ]] || { _print_running_processes "$rows"; return 1; }
}

cmd_save() {
  validate_profile_name "$1"; ensure_cli_stopped_for_mutation; ensure_state_dir; validate_active
  save_active_into "$1"; write_active_marker "$1"
  printf 'Saved active %s OAuth credentials as profile %s.\n' "$LABEL" "$1"
}

cmd_activate() {
  validate_profile_name "$1"; ensure_cli_stopped_for_mutation; ensure_state_dir; validate_profile_files "$1"
  local current=""
  if current="$(read_active_marker)"; then
    if [[ -f "${ACTIVE[0]}" ]]; then validate_active; save_active_into "$current"; fi
    if [[ "$current" == "$1" && -f "${ACTIVE[0]}" ]]; then
      printf 'Profile %s is already active; refreshed its saved credentials.\n' "$1"; return
    fi
  elif [[ -e "${ACTIVE[0]}" ]]; then
    fail "active credentials are untracked; run '$PROG save <profile>' first"
  fi
  load_profile_into_active "$1"; write_active_marker "$1"
  if [[ "$SERVICE" == codex ]]; then
    printf 'Activated Codex OAuth profile %s. Start a fresh codex process for this account.\n' "$1"
  else
    printf 'Activated Claude OAuth profile %s.\n' "$1"
  fi
}

cmd_status() {
  local current="" f files=()
  if current="$(read_active_marker 2>/dev/null)"; then printf 'Active profile: %s\n' "$current"
  else printf 'Active profile: untracked\n'; fi
  if [[ -d "$STATE_DIR" ]]; then
    shopt -s nullglob; files=("$STATE_DIR"/*."${SUFFIX[0]}"); shopt -u nullglob
  fi
  printf 'Saved profiles:'
  if [[ "${#files[@]}" -eq 0 ]]; then printf ' none\n'
  else
    for f in "${files[@]}"; do printf ' %s' "$(basename "$f" ".${SUFFIX[0]}")"; done
    printf '\n'
    # The cached-quota block is decoration on top of status; it must never be able
    # to fail the command (including being SIGPIPE'd by `status | head`).
    if [[ "$SERVICE" == claude ]]; then status_quota_claude || true
    else status_quota_codex || true; fi
  fi
  return 0
}

# The Codex half of the cached-quota block. Same discipline as the Claude one — a
# cached percentage is a lower bound (`≥N%`), an elapsed window degrades to `unknown` —
# but the number of windows is not fixed, so rows are emitted per window and each one is
# labelled from its recorded duration rather than from a hardcoded name.
status_quota_codex() {
  python3 - "$STATE_DIR" "$QUOTA_CACHE" "$ACTIVE_MARKER" "$QUOTA_CACHE_SCHEMA" "$(_quota_hint)" <<'PY'
import json, pathlib, signal, sys
from datetime import datetime, timezone

try: signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (AttributeError, ValueError): pass

state_dir = pathlib.Path(sys.argv[1]); cache_path = pathlib.Path(sys.argv[2])
active_marker = pathlib.Path(sys.argv[3]); schema = int(sys.argv[4]); hint = sys.argv[5]

profiles = sorted(p.name[: -len(".auth.json")] for p in state_dir.glob("*.auth.json"))
if not profiles:
    raise SystemExit(0)

def no_samples():
    print(f"Cached quota: no samples yet — run '{hint}'")
    raise SystemExit(0)

if not cache_path.exists():
    no_samples()
try:
    cache = json.loads(cache_path.read_text(encoding="utf-8"))
    if not isinstance(cache, dict): raise ValueError("not an object")
except Exception:
    print(f"Cached quota: unavailable (cache unreadable) — refresh with '{hint}'")
    raise SystemExit(0)
if cache.get("schema") != schema:
    print(f"Cached quota: unavailable (unsupported cache schema) — refresh with '{hint}'")
    raise SystemExit(0)
entries = cache.get("profiles")
if not isinstance(entries, dict) or not any(n in entries for n in profiles):
    no_samples()

active = ""
if active_marker.exists():
    try: active = active_marker.read_text(encoding="utf-8").strip()
    except Exception: active = ""

now = datetime.now(timezone.utc)

def parse(iso):
    if not isinstance(iso, str) or not iso: return None
    try: dt = datetime.fromisoformat(iso)
    except ValueError: return None
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)

def span(secs):
    d, rem = divmod(int(secs), 86400); h, rem = divmod(rem, 3600); m = rem // 60
    if d: return f"{d}d{h}h"
    if h: return f"{h}h{m:02d}m"
    return f"{m}m"

def label(minutes):
    if not isinstance(minutes, int) or isinstance(minutes, bool) or minutes <= 0: return "?"
    if minutes % 1440 == 0: return f"{minutes // 1440}d"
    if minutes % 60 == 0: return f"{minutes // 60}h"
    return f"{minutes}m"

def age(entry):
    fetched = parse(entry.get("fetched_at"))
    if fetched is None: return "?"
    secs = (now - fetched).total_seconds()
    if secs < 0: return "just now"
    return "just now" if secs < 60 else f"{span(secs)} ago"

rows, credits = [], []
for name in profiles:
    mark = "*" if name == active else " "
    entry = entries.get(name)
    wins = entry.get("windows") if isinstance(entry, dict) else None
    if not isinstance(wins, list) or not wins:
        rows.append((mark, name, "no sample", "", "", "")); continue
    when = age(entry)
    first = True
    for w in wins:
        if not isinstance(w, dict): continue
        util = w.get("utilization"); resets = parse(w.get("resets_at"))
        if (not isinstance(util, (int, float)) or isinstance(util, bool)
                or resets is None or (resets - now).total_seconds() <= 0):
            used, left = "unknown", "—"
        else:
            used, left = f"≥{util:.0f}%", f"in {span((resets - now).total_seconds())}"
        rows.append((mark if first else " ", name if first else "",
                     label(w.get("duration_minutes")), used, left, when if first else ""))
        first = False
    got = entry.get("reset_credits")
    if isinstance(got, dict) and isinstance(got.get("available"), int) and got["available"] > 0:
        credits.append((name, got))

w = max([len(r[1]) for r in rows] + [len("Profile")])
print()
print("Cached quota (offline snapshot, not live — a cached % is a lower bound):")
print(f"  {'Profile':<{w}}  {'window':>6}  {'used':>7}  {'resets':>9}  {'sampled':>9}")
for mark, name, win, used, left, when in rows:
    if used == "" and left == "":
        print(f"{mark} {name:<{w}}  {win}")
    else:
        print(f"{mark} {name:<{w}}  {win:>6}  {used:>7}  {left:>9}  {when:>9}")
def local_date(iso_text):
    dt = parse(iso_text)
    return dt.astimezone().strftime("%Y-%m-%d") if dt else None

for name, got in credits:
    exp = local_date(got.get("expires_at"))
    tail = f" (expires {exp})" if exp else ""
    print(f"Reset credits for {name}: {got['available']} available{tail}")
print(f"* = active profile; refresh with '{hint}'")
PY
}

# Machine-readable `status`, for callers that must decide which profile to hand work
# to. Same data and the same offline guarantee as the text form; the field names carry
# the semantics that the text form carries with "≥" and "unknown", so a consumer cannot
# read a cached number as an exact one:
#   utilization_at_least  a lower bound, never a measurement
#   state                 known | expired | missing
# Both services carry a `quota` key, but its inner shape differs because the services
# genuinely differ: Claude has exactly two named windows, Codex has a variable-length
# `windows` list identified by duration. Consumers branch on `service`.
cmd_status_json() {
  python3 - "$SERVICE" "$STATE_DIR" "${SUFFIX[0]}" "$ACTIVE_MARKER" \
           "$QUOTA_CACHE" "$QUOTA_CACHE_SCHEMA" <<'PY'
import json, pathlib, sys
from datetime import datetime, timezone

service = sys.argv[1]; state_dir = pathlib.Path(sys.argv[2]); suffix = sys.argv[3]
active_marker = pathlib.Path(sys.argv[4]); cache_path = pathlib.Path(sys.argv[5])
schema = int(sys.argv[6])

names = sorted(p.name[: -len("." + suffix)] for p in state_dir.glob("*." + suffix)) \
    if state_dir.exists() else []

active = None
if active_marker.exists():
    try:
        active = active_marker.read_text(encoding="utf-8").strip() or None
    except Exception:
        active = None

doc = {"service": service, "active_profile": active, "profiles": []}

entries, cache_state = {}, "missing"
if cache_path.exists():
    try:
        loaded = json.loads(cache_path.read_text(encoding="utf-8"))
        if not isinstance(loaded, dict):
            cache_state = "unreadable"
        elif loaded.get("schema") != schema:
            cache_state = "unsupported_schema"
        elif not isinstance(loaded.get("profiles"), dict):
            cache_state = "unreadable"
        else:
            entries, cache_state = loaded["profiles"], "ok"
    except Exception:
        cache_state = "unreadable"
doc["cache"] = {"state": cache_state}

now = datetime.now(timezone.utc)

def parse(iso):
    if not isinstance(iso, str) or not iso: return None
    try: dt = datetime.fromisoformat(iso)
    except ValueError: return None
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)

def window(entry, key):
    w = entry.get(key)
    if not isinstance(w, dict):
        return {"state": "missing", "utilization_at_least": None, "resets_at": None}
    util = w.get("utilization"); resets = parse(w.get("resets_at"))
    raw_resets = w.get("resets_at") if isinstance(w.get("resets_at"), str) else None
    if not isinstance(util, (int, float)) or isinstance(util, bool) or resets is None:
        return {"state": "missing", "utilization_at_least": None, "resets_at": raw_resets}
    if (resets - now).total_seconds() <= 0:
        # The window rolled over after the sample; the old number describes nothing.
        return {"state": "expired", "utilization_at_least": None, "resets_at": raw_resets}
    return {"state": "known", "utilization_at_least": util, "resets_at": raw_resets}

def duration_label(minutes):
    if not isinstance(minutes, int) or isinstance(minutes, bool) or minutes <= 0: return None
    if minutes % 1440 == 0: return f"{minutes // 1440}d"
    if minutes % 60 == 0: return f"{minutes // 60}h"
    return f"{minutes}m"

# Codex windows come as a list; state is computed exactly as for a Claude window so the
# two services never disagree about what "expired" or "lower bound" means.
def codex_window(w):
    if not isinstance(w, dict):
        return None
    mins = w.get("duration_minutes") if isinstance(w.get("duration_minutes"), int) else None
    raw_resets = w.get("resets_at") if isinstance(w.get("resets_at"), str) else None
    out = {"duration_minutes": mins, "label": duration_label(mins), "resets_at": raw_resets}
    util = w.get("utilization"); resets = parse(raw_resets)
    if not isinstance(util, (int, float)) or isinstance(util, bool) or resets is None:
        out.update(state="missing", utilization_at_least=None)
    elif (resets - now).total_seconds() <= 0:
        out.update(state="expired", utilization_at_least=None)
    else:
        out.update(state="known", utilization_at_least=util)
    return out

for name in names:
    row = {"name": name, "active": name == active}
    entry = entries.get(name)
    if not isinstance(entry, dict):
        row["quota"] = None
    else:
        fetched = parse(entry.get("fetched_at"))
        quota = {
            "sampled_at": entry.get("fetched_at") if isinstance(entry.get("fetched_at"), str) else None,
            "age_seconds": int((now - fetched).total_seconds()) if fetched else None,
            "source": entry.get("source") if isinstance(entry.get("source"), str) else None,
        }
        if service == "claude":
            quota["five_hour"] = window(entry, "five_hour")
            quota["seven_day"] = window(entry, "seven_day")
        else:
            wins = entry.get("windows")
            quota["windows"] = [w for w in (codex_window(x) for x in wins) if w] \
                if isinstance(wins, list) else []
            if isinstance(entry.get("plan_type"), str):
                quota["plan_type"] = entry["plan_type"]
            got = entry.get("reset_credits")
            if isinstance(got, dict) and isinstance(got.get("available"), int):
                quota["reset_credits"] = {
                    "available": got["available"],
                    "expires_at": got.get("expires_at") if isinstance(got.get("expires_at"), str) else None,
                }
        row["quota"] = quota
    doc["profiles"].append(row)

print(json.dumps(doc, indent=2, sort_keys=True))
PY
}

