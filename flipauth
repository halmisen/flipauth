# How the user would refresh the cache, phrased for the invocation name in use.
_quota_hint() {
  if [[ "$PROG" == flipauth ]]; then printf 'flipauth %s quota' "$SERVICE"; else printf '%s quota' "$PROG"; fi
}

# Render the cached quota block appended to `status`. Strictly offline: it reads
# the cache file and nothing else. A cached utilization is a *lower bound* — the
# rolling window it belongs to has a fixed reset time, so real usage can only
# have grown since the sample. It is therefore printed as ">=N%", which is enough
# to rule an account out but never enough to authorise starting one. Once that
# reset time has passed the number says nothing at all, so the window degrades to
# "unknown" rather than showing a stale percentage.
status_quota_claude() {
  python3 - "$STATE_DIR" "$QUOTA_CACHE" "$ACTIVE_MARKER" "$QUOTA_CACHE_SCHEMA" "$(_quota_hint)" <<'PY'
import json, pathlib, signal, sys
from datetime import datetime, timezone

# `status | head` / `status | grep -q` closes stdout early. Die on SIGPIPE the way
# an ordinary Unix filter does instead of dumping a BrokenPipeError traceback.
try: signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (AttributeError, ValueError): pass

state_dir = pathlib.Path(sys.argv[1]); cache_path = pathlib.Path(sys.argv[2])
active_marker = pathlib.Path(sys.argv[3]); schema = int(sys.argv[4]); hint = sys.argv[5]

profiles = sorted(p.name[: -len(".credentials.json")] for p in state_dir.glob("*.credentials.json"))
if not profiles:
    raise SystemExit(0)

def no_samples():
    print(f"Cached quota: no samples yet — run '{hint}'")
    raise SystemExit(0)

if not cache_path.exists():
    no_samples()
try:
    cache = json.loads(cache_path.read_text(encoding="utf-8"))
    if not isinstance(cache, dict):
        raise ValueError("cache is not an object")
except Exception:
    print(f"Cached quota: unavailable (cache unreadable) — refresh with '{hint}'")
    raise SystemExit(0)
if cache.get("schema") != schema:
    print(f"Cached quota: unavailable (unsupported cache schema) — refresh with '{hint}'")
    raise SystemExit(0)
entries = cache.get("profiles")
if not isinstance(entries, dict) or not any(n in entries for n in profiles):
    no_samples()

active = ""
if active_marker.exists():
    try: active = active_marker.read_text(encoding="utf-8").strip()
    except Exception: active = ""

now = datetime.now(timezone.utc)

def parse(iso):
    if not isinstance(iso, str) or not iso: return None
    try: dt = datetime.fromisoformat(iso)
    except ValueError: return None
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)

def span(secs):
    d, rem = divmod(int(secs), 86400); h, rem = divmod(rem, 3600); m = rem // 60
    if d: return f"{d}d{h}h"
    if h: return f"{h}h{m:02d}m"
    return f"{m}m"

def window(entry, key):
    w = entry.get(key)
    if not isinstance(w, dict): return "unknown", "—"
    util = w.get("utilization"); resets = parse(w.get("resets_at"))
    if not isinstance(util, (int, float)) or resets is None: return "unknown", "—"
    secs = (resets - now).total_seconds()
    if secs <= 0: return "unknown", "—"   # window rolled over; the sample is void
    return f"≥{util:.0f}%", f"in {span(secs)}"

def age(entry):
    fetched = parse(entry.get("fetched_at"))
    if fetched is None: return "?"
    secs = (now - fetched).total_seconds()
    if secs < 0: return "just now"
    return "just now" if secs < 60 else f"{span(secs)} ago"

rows = []
for name in profiles:
    mark = "*" if name == active else " "
    entry = entries.get(name)
    if not isinstance(entry, dict):
        rows.append((mark, name, None)); continue
    h5, h5r = window(entry, "five_hour")
    d7, d7r = window(entry, "seven_day")
    rows.append((mark, name, (h5, h5r, d7, d7r, age(entry))))

w = max(len(r[1]) for r in rows + [("", "Profile", None)])
print()
print("Cached quota (offline snapshot, not live — a cached % is a lower bound):")
print(f"  {'Profile':<{w}}  {'5h':>7}  {'resets':>8}  {'7d':>7}  {'resets':>8}  {'sampled':>9}")
for mark, name, data in rows:
    if data is None:
        print(f"{mark} {name:<{w}}  no sample")
    else:
        h5, h5r, d7, d7r, when = data
        print(f"{mark} {name:<{w}}  {h5:>7}  {h5r:>8}  {d7:>7}  {d7r:>8}  {when:>9}")
print(f"* = active profile; refresh with '{hint}'")
PY
}

# Record a rate-limit observation that Claude Code handed us for free.
#
# Claude Code pipes a JSON payload into the configured statusLine command on every
# render, and for Claude.ai subscribers that payload already carries the same two
# rolling windows the `quota` command pays a network request for. Hooking a single
# line onto the end of an existing statusLine script therefore keeps the *active*
# profile's cache continuously fresh at zero cost — and, more usefully, means that
# when you switch away from a profile its last sample is from seconds earlier rather
# than from whenever you last remembered to run `quota`.
#
# Two constraints follow from running inside a status line:
#   - It must never fail loudly. A broken payload, a missing marker, or an unwritable
#     cache all exit quietly; breaking someone's prompt to record telemetry is absurd.
#   - It must not write on every render. Writes are skipped while the values are
#     unchanged and the existing sample is under a minute old.
#
# Attribution note: the payload does not identify the account, so the observation is
# filed under whatever `.active-profile` says. flipauth keeps that marker correct when
# it performs the switch; a login performed outside flipauth can make it stale, and
# there is no account identifier in Claude credentials to cross-check against.
cmd_observe() {
  [[ "$SERVICE" == claude ]] ||
    fail "observe is Claude-only (it consumes a Claude Code statusLine payload); not supported for $SERVICE"
  local payload
  payload="$(cat 2>/dev/null || true)"
  [[ -n "$payload" ]] || return 0
  python3 - "$payload" "$ACTIVE_MARKER" "$QUOTA_CACHE" "$QUOTA_CACHE_SCHEMA" \
           "${OBSERVE_MIN_INTERVAL:-60}" <<'PY' || true
import json, os, pathlib, sys, tempfile
from datetime import datetime, timezone

payload_raw = sys.argv[1]; active_marker = pathlib.Path(sys.argv[2])
cache_path = pathlib.Path(sys.argv[3]); schema = int(sys.argv[4])
min_interval = float(sys.argv[5])

def quit_quietly():
    raise SystemExit(0)

try:
    payload = json.loads(payload_raw)
except Exception:
    quit_quietly()
if not isinstance(payload, dict):
    quit_quietly()

limits = payload.get("rate_limits")
if not isinstance(limits, dict):
    quit_quietly()          # API-key users have no subscription windows

try:
    profile = active_marker.read_text(encoding="utf-8").strip()
except Exception:
    quit_quietly()
if not profile:
    quit_quietly()

now = datetime.now(timezone.utc)

# statusLine reports resets_at as a unix epoch; the usage endpoint reports ISO.
# Normalise to ISO here so one cache never holds two time formats.
def to_iso(value):
    if isinstance(value, bool) or value is None: return None
    if isinstance(value, (int, float)):
        return datetime.fromtimestamp(value, timezone.utc).isoformat(timespec="seconds")
    if isinstance(value, str):
        text = value.strip()
        if not text: return None
        try:
            return datetime.fromtimestamp(float(text), timezone.utc).isoformat(timespec="seconds")
        except ValueError:
            pass
        try:
            dt = datetime.fromisoformat(text)
        except ValueError:
            return None
        return (dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)).isoformat(timespec="seconds")
    return None

# Both sources express utilization on the same 0-100 scale, so the value is copied
# straight across. Allow-listed, like every other cache write.
def window(src):
    if not isinstance(src, dict): return None
    out = {}
    used = src.get("used_percentage")
    if isinstance(used, (int, float)) and not isinstance(used, bool):
        out["utilization"] = used
    resets = to_iso(src.get("resets_at"))
    if resets: out["resets_at"] = resets
    return out or None

entry = {"fetched_at": now.isoformat(timespec="seconds"), "source": "statusline"}
for key, src_key in (("five_hour", "five_hour"), ("seven_day", "seven_day")):
    w = window(limits.get(src_key))
    if w: entry[key] = w
if "five_hour" not in entry and "seven_day" not in entry:
    quit_quietly()

kept = {}
if cache_path.exists():
    try:
        loaded = json.loads(cache_path.read_text(encoding="utf-8"))
        if (isinstance(loaded, dict) and loaded.get("schema") == schema
                and isinstance(loaded.get("profiles"), dict)):
            kept = loaded["profiles"]
    except Exception:
        kept = {}

# Skip the write while nothing has moved and the existing sample is still young.
prev = kept.get(profile)
if isinstance(prev, dict) and prev.get("source") == "statusline":
    same = all(
        (prev.get(k) or {}).get("utilization") == (entry.get(k) or {}).get("utilization")
        for k in ("five_hour", "seven_day"))
    if same:
        try:
            age = (now - datetime.fromisoformat(prev["fetched_at"])).total_seconds()
        except Exception:
            age = min_interval + 1
        if age < min_interval:
            quit_quietly()

kept[profile] = entry
tmp = None
try:
    cache_path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(cache_path.parent), prefix=".quota-cache.")
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump({"schema": schema, "profiles": kept}, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, cache_path); tmp = None
except Exception:
    if tmp:
        try: os.unlink(tmp)
        except OSError: pass
PY
  return 0
}

# Query Anthropic's OAuth usage endpoint for each saved Claude profile and print
# 5-hour / 7-day rolling-window utilization plus reset countdowns. This is the
# only command that makes a network call; everything else is offline file work.
quota_claude() {
  local user_agent api_base want="${1:-}"
  user_agent="$(_claude_user_agent)"
  api_base="${CLAUDE_SWITCH_API_BASE:-https://api.anthropic.com}"
  python3 - "$STATE_DIR" "$ACTIVE_MARKER" "${ACTIVE[0]}" "$user_agent" "$api_base" "$want" \
           "$QUOTA_CACHE" "$QUOTA_CACHE_SCHEMA" <<'PY'
import json, os, pathlib, sys, tempfile, urllib.request, urllib.error
from datetime import datetime, timezone

state_dir = pathlib.Path(sys.argv[1]); active_marker = pathlib.Path(sys.argv[2])
live = pathlib.Path(sys.argv[3]); user_agent = sys.argv[4]
api_base = sys.argv[5].rstrip("/"); want = sys.argv[6]
cache_path = pathlib.Path(sys.argv[7]); cache_schema = int(sys.argv[8])

active = ""
if active_marker.exists():
    try: active = active_marker.read_text(encoding="utf-8").strip()
    except Exception: active = ""

# Collect profiles: name -> credentials path. The active profile uses the live
# file (freshest token); others use their saved snapshot (may be stale/expired).
profiles = {}
if state_dir.exists():
    for p in sorted(state_dir.glob("*.credentials.json")):
        profiles[p.name[: -len(".credentials.json")]] = p
if active and live.exists():
    profiles[active] = live
if want:
    profiles = {k: v for k, v in profiles.items() if k == want}
    if not profiles:
        print(f"no saved profile named {want}"); raise SystemExit(1)
if not profiles:
    print("Saved profiles: none"); raise SystemExit(0)

def token_of(path):
    try:
        oauth = json.loads(path.read_text(encoding="utf-8"))["claudeAiOauth"]
        return oauth.get("accessToken") or ""
    except Exception:
        return ""

def fetch(token):
    req = urllib.request.Request(
        f"{api_base}/api/oauth/usage",
        headers={"Authorization": f"Bearer {token}",
                 "anthropic-beta": "oauth-2025-04-20",
                 "User-Agent": user_agent,
                 "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.loads(r.read().decode("utf-8"))

def rel(iso):
    if not iso: return "—"
    try: dt = datetime.fromisoformat(iso)
    except Exception: return "?"
    if dt.tzinfo is None: dt = dt.replace(tzinfo=timezone.utc)
    secs = (dt - datetime.now(timezone.utc)).total_seconds()
    if secs <= 0: return "due"
    d, rem = divmod(int(secs), 86400); h, rem = divmod(rem, 3600); m = rem // 60
    if d: return f"in {d}d{h}h"
    if h: return f"in {h}h{m:02d}m"
    return f"in {m}m"

def pct(window):
    if not isinstance(window, dict): return "—", ""
    u = window.get("utilization")
    return (f"{u:.0f}%" if isinstance(u, (int, float)) else "—",
            rel(window.get("resets_at")))

# Build the cache entry for one successful response. Strictly allow-listed: only
# the two rolling windows' utilization and reset time, plus when and from which
# credential file the sample came. Tokens and any other response field are dropped.
def sample_of(data, path):
    def win(w):
        if not isinstance(w, dict): return None
        out = {}
        if isinstance(w.get("utilization"), (int, float)): out["utilization"] = w["utilization"]
        if isinstance(w.get("resets_at"), str): out["resets_at"] = w["resets_at"]
        return out or None
    entry = {"fetched_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
             "source": "live" if path == live else "snapshot"}
    for key in ("five_hour", "seven_day"):
        w = win(data.get(key))
        if w: entry[key] = w
    return entry

# Merge successful samples into the cache. Only profiles that answered are
# touched, so a single-profile query never drops the others, and a run where
# every profile failed leaves the last good samples in place.
def write_cache(samples):
    if not samples: return
    kept = {}
    if cache_path.exists():
        try:
            loaded = json.loads(cache_path.read_text(encoding="utf-8"))
