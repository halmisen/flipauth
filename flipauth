               429: "rate limited (retry >180s)"}.get(e.code, f"HTTP {e.code}")
        rows.append((mark, name, msg, "", "", "")); continue
    except Exception as e:
        rows.append((mark, name, f"error: {type(e).__name__}", "", "", "")); continue
    samples[name] = sample_of(data, path)
    h5, h5r = pct(data.get("five_hour"))
    d7, d7r = pct(data.get("seven_day"))
    rows.append((mark, name, h5, h5r, d7, d7r))

write_cache(samples)

w = max(len(r[1]) for r in rows + [("", "Profile", "", "", "", "")])
print(f"  {'Profile':<{w}}  {'5h':>5}  {'resets':>8}  {'7d':>5}  {'resets':>8}")
for mark, name, h5, h5r, d7, d7r in rows:
