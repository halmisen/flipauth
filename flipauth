#!/usr/bin/env bash
set -euo pipefail

# flipauth — OAuth profile switcher for the official Claude Code and Codex CLIs.
# Service is resolved from the invocation name ($0):
#   claude-switch ...       -> service=claude
#   codex-switch  ...       -> service=codex
#   flipauth <svc> ...      -> service=<svc>  (claude|codex)
#
# Platform: Windows WSL only.

PROG="$(basename "$0")"

fail() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

case "$PROG" in
  claude-switch) SERVICE=claude ;;
  codex-switch)  SERVICE=codex ;;
  *)
    SERVICE="${1:-}"
    [[ -n "$SERVICE" ]] || fail "usage: flipauth <claude|codex> <command> [args]"
    shift
    ;;
esac
[[ "$SERVICE" == claude || "$SERVICE" == codex ]] ||
  fail "unknown service '$SERVICE' (expected claude or codex)"

# Index-aligned arrays describe the managed runtime files:
#   ACTIVE[i]   absolute path of the live file
#   SUFFIX[i]   saved-profile filename suffix (profile file = <name>.<suffix>)
#   REQUIRED[i] "yes" if the live file must exist to save, "no" if optional
declare -a ACTIVE SUFFIX REQUIRED

if [[ "$SERVICE" == claude ]]; then
  DIR="${CLAUDE_SWITCH_CLAUDE_DIR:-$HOME/.claude}"
  STATE_DIR="${CLAUDE_SWITCH_STATE_DIR:-$DIR/oauth-accounts}"
  ACTIVE=( "${CLAUDE_SWITCH_CREDENTIALS_FILE:-$DIR/.credentials.json}" )
  SUFFIX=( "credentials.json" )
  REQUIRED=( "yes" )
  LABEL="Claude"
else
  DIR="${CODEX_SWITCH_CODEX_DIR:-$HOME/.codex}"
  STATE_DIR="${CODEX_SWITCH_STATE_DIR:-$DIR/oauth-accounts}"
  ACTIVE=( "${CODEX_SWITCH_AUTH_FILE:-$DIR/auth.json}" "${CODEX_SWITCH_CREDENTIALS_FILE:-$DIR/.credentials.json}" )
  SUFFIX=( "auth.json" "credentials.json" )
  REQUIRED=( "yes" "no" )
  LABEL="Codex"
fi

ACTIVE_MARKER="$STATE_DIR/.active-profile"
# Claude-only: last successful /api/oauth/usage sample per profile. Quota-shaped
# fields only — never tokens, headers, or unrelated response fields.
QUOTA_CACHE="$STATE_DIR/.quota-cache.json"
QUOTA_CACHE_SCHEMA=1

usage() {
  cat <<USAGE
Usage:
  $PROG save <profile>
  $PROG <profile>
  $PROG status [--json]
  $PROG doctor
USAGE
  [[ "$SERVICE" == claude ]] && printf '  %s quota [profile]\n' "$PROG"
  [[ "$SERVICE" == claude ]] && printf '  %s observe            (reads a statusLine JSON payload on stdin)\n' "$PROG"
  [[ "$SERVICE" == claude ]] && printf '  %s login <profile> [claude auth login options]\n' "$PROG"
  return 0
}

validate_profile_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] ||
    fail "profile names must use letters, digits, underscores, or hyphens"
}

profile_path() { printf '%s/%s.%s\n' "$STATE_DIR" "$1" "${SUFFIX[$2]}"; }

ensure_state_dir() { mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"; }

validate_json_object() {
  python3 - "$1" <<'PY'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
try:
    payload = json.loads(p.read_text(encoding="utf-8"))
except FileNotFoundError:
    raise SystemExit(f"missing credentials file: {p}")
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"invalid credentials file {p}: {exc}")
if not isinstance(payload, dict):
    raise SystemExit(f"unexpected credentials shape in {p}: expected object")
PY
}

validate_claude_credentials() {
  python3 - "$1" <<'PY'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
try:
    payload = json.loads(p.read_text(encoding="utf-8"))
except FileNotFoundError:
    raise SystemExit(f"missing credentials file: {p}")
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"invalid credentials file {p}: {exc}")
if not isinstance(payload, dict):
    raise SystemExit(f"unexpected credentials shape in {p}: expected object")
if "claudeAiOauth" not in payload:
    raise SystemExit(f"unexpected credentials shape in {p}: expected claudeAiOauth")
if not isinstance(payload["claudeAiOauth"], dict):
    raise SystemExit(f"unexpected claudeAiOauth value in {p}: expected an object")
PY
}

validate_file() {
  if [[ "$SERVICE" == claude ]]; then validate_claude_credentials "$1"; else validate_json_object "$1"; fi
}

atomic_copy() {
  local src="$1" dst="$2" dir tmp
  dir="$(dirname "$dst")"; mkdir -p "$dir"; umask 077
  tmp="$(mktemp "$dir/.oauth-switch.XXXXXX")"
  if ! install -m 600 "$src" "$tmp"; then rm -f "$tmp"; return 1; fi
  mv -f "$tmp" "$dst"; chmod 600 "$dst"
}

write_active_marker() {
  local tmp; umask 077
  tmp="$(mktemp "$STATE_DIR/.active-profile.XXXXXX")"
  printf '%s\n' "$1" > "$tmp"; mv -f "$tmp" "$ACTIVE_MARKER"; chmod 600 "$ACTIVE_MARKER"
}

read_active_marker() {
  local p
  [[ -f "$ACTIVE_MARKER" ]] || return 1
  IFS= read -r p < "$ACTIVE_MARKER" || return 1
  validate_profile_name "$p"; printf '%s\n' "$p"
}

validate_active() {
  local i
  for i in "${!ACTIVE[@]}"; do
    if [[ "${REQUIRED[$i]}" == yes ]]; then validate_file "${ACTIVE[$i]}"
    elif [[ -f "${ACTIVE[$i]}" ]]; then validate_json_object "${ACTIVE[$i]}"; fi
  done
}

validate_profile_files() {
  local i path
  for i in "${!ACTIVE[@]}"; do
    path="$(profile_path "$1" "$i")"
    if [[ "${REQUIRED[$i]}" == yes ]]; then validate_file "$path"
    elif [[ -f "$path" ]]; then validate_json_object "$path"; fi
  done
}

save_active_into() {
  local i path
  for i in "${!ACTIVE[@]}"; do
    if [[ -f "${ACTIVE[$i]}" ]]; then
      path="$(profile_path "$1" "$i")"
      atomic_copy "${ACTIVE[$i]}" "$path"
    elif [[ "${REQUIRED[$i]}" == yes ]]; then
      fail "required active file disappeared: ${ACTIVE[$i]}"
    fi
  done
}

load_profile_into_active() {
  local i path
  for i in "${!ACTIVE[@]}"; do
    path="$(profile_path "$1" "$i")"
    if [[ -f "$path" ]]; then
      atomic_copy "$path" "${ACTIVE[$i]}"
    elif [[ "${REQUIRED[$i]}" == yes ]]; then
      fail "required profile file disappeared: $path"
    fi
  done
}

cmd_save() {
  validate_profile_name "$1"; ensure_state_dir; validate_active
  save_active_into "$1"; write_active_marker "$1"
  printf 'Saved active %s OAuth credentials as profile %s.\n' "$LABEL" "$1"
}

cmd_activate() {
  validate_profile_name "$1"; ensure_state_dir; validate_profile_files "$1"
  local current=""
  if current="$(read_active_marker)"; then
    if [[ -f "${ACTIVE[0]}" ]]; then validate_active; save_active_into "$current"; fi
    if [[ "$current" == "$1" && -f "${ACTIVE[0]}" ]]; then
      printf 'Profile %s is already active; refreshed its saved credentials.\n' "$1"; return
    fi
  elif [[ -e "${ACTIVE[0]}" ]]; then
    fail "active credentials are untracked; run '$PROG save <profile>' first"
  fi
  load_profile_into_active "$1"; write_active_marker "$1"
  if [[ "$SERVICE" == codex ]]; then
    printf 'Activated Codex OAuth profile %s. Start a fresh codex process for this account.\n' "$1"
  else
    printf 'Activated Claude OAuth profile %s.\n' "$1"
  fi
}

cmd_status() {
  local current="" f files=()
  if current="$(read_active_marker 2>/dev/null)"; then printf 'Active profile: %s\n' "$current"
  else printf 'Active profile: untracked\n'; fi
  if [[ -d "$STATE_DIR" ]]; then
    shopt -s nullglob; files=("$STATE_DIR"/*."${SUFFIX[0]}"); shopt -u nullglob
  fi
  printf 'Saved profiles:'
  if [[ "${#files[@]}" -eq 0 ]]; then printf ' none\n'
  else
    for f in "${files[@]}"; do printf ' %s' "$(basename "$f" ".${SUFFIX[0]}")"; done
    printf '\n'
    # The cached-quota block is decoration on top of status; it must never be able
    # to fail the command (including being SIGPIPE'd by `status | head`).
    [[ "$SERVICE" == claude ]] && { status_quota_claude || true; }
  fi
  return 0
}

# Machine-readable `status`, for callers that must decide which profile to hand work
# to. Same data and the same offline guarantee as the text form; the field names carry
# the semantics that the text form carries with "≥" and "unknown", so a consumer cannot
# read a cached number as an exact one:
#   utilization_at_least  a lower bound, never a measurement
#   state                 known | expired | missing
# Codex profiles carry no `quota` key at all — the field is absent rather than null,
# because Codex has no usage endpoint, not because it is merely unsampled.
cmd_status_json() {
  python3 - "$SERVICE" "$STATE_DIR" "${SUFFIX[0]}" "$ACTIVE_MARKER" \
           "$QUOTA_CACHE" "$QUOTA_CACHE_SCHEMA" <<'PY'
import json, pathlib, sys
from datetime import datetime, timezone

service = sys.argv[1]; state_dir = pathlib.Path(sys.argv[2]); suffix = sys.argv[3]
active_marker = pathlib.Path(sys.argv[4]); cache_path = pathlib.Path(sys.argv[5])
schema = int(sys.argv[6])

names = sorted(p.name[: -len("." + suffix)] for p in state_dir.glob("*." + suffix)) \
    if state_dir.exists() else []

active = None
if active_marker.exists():
    try:
        active = active_marker.read_text(encoding="utf-8").strip() or None
    except Exception:
        active = None

doc = {"service": service, "active_profile": active, "profiles": []}

entries, cache_state = {}, "missing"
if service == "claude":
    if cache_path.exists():
        try:
            loaded = json.loads(cache_path.read_text(encoding="utf-8"))
            if not isinstance(loaded, dict):
                cache_state = "unreadable"
            elif loaded.get("schema") != schema:
                cache_state = "unsupported_schema"
            elif not isinstance(loaded.get("profiles"), dict):
                cache_state = "unreadable"
            else:
                entries, cache_state = loaded["profiles"], "ok"
        except Exception:
            cache_state = "unreadable"
    doc["cache"] = {"state": cache_state}

now = datetime.now(timezone.utc)

def parse(iso):
    if not isinstance(iso, str) or not iso: return None
    try: dt = datetime.fromisoformat(iso)
    except ValueError: return None
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)

def window(entry, key):
    w = entry.get(key)
    if not isinstance(w, dict):
        return {"state": "missing", "utilization_at_least": None, "resets_at": None}
    util = w.get("utilization"); resets = parse(w.get("resets_at"))
    raw_resets = w.get("resets_at") if isinstance(w.get("resets_at"), str) else None
    if not isinstance(util, (int, float)) or isinstance(util, bool) or resets is None:
        return {"state": "missing", "utilization_at_least": None, "resets_at": raw_resets}
    if (resets - now).total_seconds() <= 0:
        # The window rolled over after the sample; the old number describes nothing.
        return {"state": "expired", "utilization_at_least": None, "resets_at": raw_resets}
    return {"state": "known", "utilization_at_least": util, "resets_at": raw_resets}

for name in names:
    row = {"name": name, "active": name == active}
    if service == "claude":
        entry = entries.get(name)
        if not isinstance(entry, dict):
            row["quota"] = None
        else:
            fetched = parse(entry.get("fetched_at"))
            row["quota"] = {
                "sampled_at": entry.get("fetched_at") if isinstance(entry.get("fetched_at"), str) else None,
                "age_seconds": int((now - fetched).total_seconds()) if fetched else None,
                "source": entry.get("source") if isinstance(entry.get("source"), str) else None,
                "five_hour": window(entry, "five_hour"),
                "seven_day": window(entry, "seven_day"),
            }
    doc["profiles"].append(row)

print(json.dumps(doc, indent=2, sort_keys=True))
PY
}

cmd_login() {
  [[ "$SERVICE" == claude ]] || fail "login is not supported for $SERVICE; use 'codex login' manually"
  local profile="$1"; shift
  validate_profile_name "$profile"; ensure_state_dir
  command -v claude >/dev/null 2>&1 || fail "claude command not found"
  local login_dir login_creds current=""
  login_dir="$(mktemp -d "$STATE_DIR/.login-$profile.XXXXXX")"
  login_creds="$login_dir/.credentials.json"
  if ! CLAUDE_CONFIG_DIR="$login_dir" claude auth login "$@"; then
    rm -rf "$login_dir"; fail "Claude login did not complete"
  fi
  validate_claude_credentials "$login_creds"
  atomic_copy "$login_creds" "$(profile_path "$profile" 0)"
  if current="$(read_active_marker)" && [[ "$current" == "$profile" ]]; then
    atomic_copy "$login_creds" "${ACTIVE[0]}"
    printf 'Re-authenticated active Claude OAuth profile %s.\n' "$profile"
  else
    printf 'Saved Claude OAuth login as profile %s.\n' "$profile"
    printf 'Activate it with: %s %s\n' "$PROG" "$profile"
  fi
  rm -rf "$login_dir"
}

# Resolve the Windows-side Codex auth path.
# Priority: CODEX_SWITCH_WINDOWS_AUTH env var > wslvar/wslpath detection > empty.
_resolve_windows_auth() {
  # If the variable is set (even to empty), use its value and skip auto-detection.
  # Empty value = explicitly disabled; non-empty = explicit path override.
  if [[ "${CODEX_SWITCH_WINDOWS_AUTH+set}" == set ]]; then
    printf '%s' "${CODEX_SWITCH_WINDOWS_AUTH}"
    return
  fi
  # Try wslvar (part of wslu package)
  local userprofile wsl_path
  if userprofile="$(wslvar USERPROFILE 2>/dev/null)" && [[ -n "$userprofile" ]]; then
    if wsl_path="$(wslpath "$userprofile" 2>/dev/null)" && [[ -n "$wsl_path" ]]; then
      printf '%s/.codex/auth.json' "$wsl_path"
      return
    fi
  fi
  # Try cmd.exe as fallback
  if userprofile="$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r\n')" && [[ -n "$userprofile" && "$userprofile" != '%USERPROFILE%' ]]; then
    if wsl_path="$(wslpath "$userprofile" 2>/dev/null)" && [[ -n "$wsl_path" ]]; then
      printf '%s/.codex/auth.json' "$wsl_path"
      return
    fi
  fi
  printf ''
}

doctor_codex() {
  local windows_auth_path
  windows_auth_path="$(_resolve_windows_auth)"
  python3 - "$DIR" "${ACTIVE[0]}" "${ACTIVE[1]}" "$STATE_DIR" "$ACTIVE_MARKER" "$windows_auth_path" <<'PY'
import base64, hashlib, json, pathlib, stat, sys, time
codex_dir = pathlib.Path(sys.argv[1]); active_auth = pathlib.Path(sys.argv[2])
active_credentials = pathlib.Path(sys.argv[3]); state_dir = pathlib.Path(sys.argv[4])
active_marker = pathlib.Path(sys.argv[5])
_win_arg = sys.argv[6] if len(sys.argv) > 6 else ""
windows_auth = pathlib.Path(_win_arg) if _win_arg else None

def sha16(data): return hashlib.sha256(data).hexdigest()[:16]
def fp(value): return "none" if not value else hashlib.sha256(str(value).encode("utf-8")).hexdigest()[:16]
def decode_jwt_payload(token):
    parts = token.split(".")
    if len(parts) < 2: return {}
    raw = parts[1] + "=" * (-len(parts[1]) % 4)
    try: return json.loads(base64.urlsafe_b64decode(raw.encode("utf-8")))
    except Exception: return {}

def auth_summary(path):
    if not path.exists(): return {"exists": False}
    data = path.read_bytes()
    s = {"exists": True, "auth_mode": "unknown", "identity_fp": "unknown", "sub_fp": "unknown", "access_exp": "unknown"}
    try: payload = json.loads(data.decode("utf-8"))
    except Exception: return s
    if not isinstance(payload, dict): return s
    s["auth_mode"] = str(payload.get("auth_mode", "unknown"))
    tokens = payload.get("tokens") if isinstance(payload.get("tokens"), dict) else {}
    access = tokens.get("access_token") or payload.get("OPENAI_API_KEY") or ""
    claims = decode_jwt_payload(access) if isinstance(access, str) else {}
    s["identity_fp"] = fp(claims.get("https://api.openai.com/auth") or claims.get("sub"))
    s["sub_fp"] = fp(claims.get("sub"))
    exp = claims.get("exp")
    if isinstance(exp, int): s["access_exp"] = time.strftime("%Y-%m-%d %H:%M:%S %Z", time.localtime(exp))
    return s

def file_line(label, path):
    if not path.exists(): print(f"{label}: missing {path}"); return
    data = path.read_bytes(); mode = stat.S_IMODE(path.stat().st_mode)
    try: valid = isinstance(json.loads(data.decode("utf-8")), dict)
    except Exception: valid = False
    print(f"{label}: path={path} mode={oct(mode)} size={len(data)} sha16={sha16(data)} json_object={str(valid).lower()}")

print("Codex switch doctor")
print(f"codex_dir: {codex_dir}")
print(f"state_dir: {state_dir}")
if active_marker.exists():
    try: print(f"active_profile: {active_marker.read_text(encoding='utf-8').strip()}")
    except Exception as exc: print(f"active_profile: unreadable ({exc})")
else: print("active_profile: untracked")
profiles = sorted(p.name.removesuffix(".auth.json") for p in state_dir.glob("*.auth.json")) if state_dir.exists() else []
print("saved_profiles:", " ".join(profiles) if profiles else "none")
file_line("wsl_auth", active_auth)
file_line("wsl_credentials", active_credentials)
if state_dir.exists(): print(f"state_dir_mode: {oct(stat.S_IMODE(state_dir.stat().st_mode))}")
wsl = auth_summary(active_auth)
if wsl.get("exists"):
    print(f"wsl_identity: auth_mode={wsl['auth_mode']} identity_fp={wsl['identity_fp']} sub_fp={wsl['sub_fp']} access_exp={wsl['access_exp']}")
else: print("wsl_identity: missing")
if windows_auth is None:
    print("windows_identity: not configured")
elif not windows_auth.exists():
    print(f"windows_identity: missing {windows_auth}")
else:
    win = auth_summary(windows_auth)
    print(f"windows_identity: path={windows_auth} auth_mode={win['auth_mode']} identity_fp={win['identity_fp']} sub_fp={win['sub_fp']} access_exp={win['access_exp']}")
    if wsl.get("exists") and wsl.get("identity_fp") != "unknown":
        print(f"wsl_windows_same_identity: {str(wsl.get('identity_fp') == win.get('identity_fp')).lower()}")
print("scope: manages WSL Codex CLI only; Windows Codex App remains manual")
PY
}

doctor_claude() {
  python3 - "$DIR" "${ACTIVE[0]}" "$STATE_DIR" "$ACTIVE_MARKER" <<'PY'
import hashlib, json, pathlib, stat, sys, time
claude_dir = pathlib.Path(sys.argv[1]); active = pathlib.Path(sys.argv[2])
state_dir = pathlib.Path(sys.argv[3]); active_marker = pathlib.Path(sys.argv[4])

def sha16(data): return hashlib.sha256(data).hexdigest()[:16]

print("Claude switch doctor")
print(f"claude_dir: {claude_dir}")
print(f"state_dir: {state_dir}")
if active_marker.exists():
    try: print(f"active_profile: {active_marker.read_text(encoding='utf-8').strip()}")
    except Exception as exc: print(f"active_profile: unreadable ({exc})")
else: print("active_profile: untracked")
profiles = sorted(p.name.removesuffix(".credentials.json") for p in state_dir.glob("*.credentials.json")) if state_dir.exists() else []
print("saved_profiles:", " ".join(profiles) if profiles else "none")

if active.exists():
    data = active.read_bytes(); mode = stat.S_IMODE(active.stat().st_mode)
    try: payload = json.loads(data.decode("utf-8")); valid = isinstance(payload, dict)
    except Exception: payload = {}; valid = False
    print(f"active_credentials: path={active} mode={oct(mode)} size={len(data)} sha16={sha16(data)} json_object={str(valid).lower()}")
    oauth = payload.get("claudeAiOauth") if isinstance(payload, dict) else None
    if isinstance(oauth, dict):
        print(f"subscription_type: {oauth.get('subscriptionType', 'unknown')}")
        exp = oauth.get("expiresAt")
        if isinstance(exp, (int, float)):
            print(f"expires_at: {time.strftime('%Y-%m-%d %H:%M:%S %Z', time.localtime(exp / 1000))}")
        else:
            print("expires_at: unknown")
    else:
        print("subscription_type: unknown")
        print("expires_at: unknown")
else:
    print(f"active_credentials: missing {active}")
if state_dir.exists(): print(f"state_dir_mode: {oct(stat.S_IMODE(state_dir.stat().st_mode))}")
print("note: Claude access token is opaque (not a JWT); identity/email are not derivable here")
print("scope: manages WSL Claude Code credentials only")
PY
}

cmd_doctor() {
  if [[ "$SERVICE" == codex ]]; then doctor_codex; else doctor_claude; fi
}

# Read the Claude Code version for the required User-Agent, falling back to a
# recent default if the claude CLI is not installed.
_claude_user_agent() {
  local ver=""
  if command -v claude >/dev/null 2>&1; then
    ver="$(claude --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
  fi
  printf 'claude-code/%s' "${ver:-2.1.181}"
}

# How the user would refresh the cache, phrased for the invocation name in use.
_quota_hint() {
  if [[ "$PROG" == flipauth ]]; then printf 'flipauth claude quota'; else printf '%s quota' "$PROG"; fi
}

# Render the cached quota block appended to `status`. Strictly offline: it reads
# the cache file and nothing else. A cached utilization is a *lower bound* — the
# rolling window it belongs to has a fixed reset time, so real usage can only
# have grown since the sample. It is therefore printed as ">=N%", which is enough
# to rule an account out but never enough to authorise starting one. Once that
# reset time has passed the number says nothing at all, so the window degrades to
# "unknown" rather than showing a stale percentage.
status_quota_claude() {
  python3 - "$STATE_DIR" "$QUOTA_CACHE" "$ACTIVE_MARKER" "$QUOTA_CACHE_SCHEMA" "$(_quota_hint)" <<'PY'
import json, pathlib, signal, sys
from datetime import datetime, timezone

# `status | head` / `status | grep -q` closes stdout early. Die on SIGPIPE the way
# an ordinary Unix filter does instead of dumping a BrokenPipeError traceback.
try: signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (AttributeError, ValueError): pass

state_dir = pathlib.Path(sys.argv[1]); cache_path = pathlib.Path(sys.argv[2])
active_marker = pathlib.Path(sys.argv[3]); schema = int(sys.argv[4]); hint = sys.argv[5]

profiles = sorted(p.name[: -len(".credentials.json")] for p in state_dir.glob("*.credentials.json"))
if not profiles:
    raise SystemExit(0)

def no_samples():
    print(f"Cached quota: no samples yet — run '{hint}'")
    raise SystemExit(0)

if not cache_path.exists():
    no_samples()
try:
    cache = json.loads(cache_path.read_text(encoding="utf-8"))
    if not isinstance(cache, dict):
        raise ValueError("cache is not an object")
except Exception:
    print(f"Cached quota: unavailable (cache unreadable) — refresh with '{hint}'")
    raise SystemExit(0)
if cache.get("schema") != schema:
    print(f"Cached quota: unavailable (unsupported cache schema) — refresh with '{hint}'")
    raise SystemExit(0)
entries = cache.get("profiles")
if not isinstance(entries, dict) or not any(n in entries for n in profiles):
    no_samples()

active = ""
if active_marker.exists():
    try: active = active_marker.read_text(encoding="utf-8").strip()
    except Exception: active = ""

now = datetime.now(timezone.utc)

def parse(iso):
    if not isinstance(iso, str) or not iso: return None
    try: dt = datetime.fromisoformat(iso)
    except ValueError: return None
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)

def span(secs):
    d, rem = divmod(int(secs), 86400); h, rem = divmod(rem, 3600); m = rem // 60
    if d: return f"{d}d{h}h"
    if h: return f"{h}h{m:02d}m"
    return f"{m}m"

def window(entry, key):
    w = entry.get(key)
    if not isinstance(w, dict): return "unknown", "—"
    util = w.get("utilization"); resets = parse(w.get("resets_at"))
    if not isinstance(util, (int, float)) or resets is None: return "unknown", "—"
    secs = (resets - now).total_seconds()
    if secs <= 0: return "unknown", "—"   # window rolled over; the sample is void
    return f"≥{util:.0f}%", f"in {span(secs)}"

def age(entry):
    fetched = parse(entry.get("fetched_at"))
    if fetched is None: return "?"
    secs = (now - fetched).total_seconds()
    if secs < 0: return "just now"
    return "just now" if secs < 60 else f"{span(secs)} ago"

rows = []
for name in profiles:
    mark = "*" if name == active else " "
    entry = entries.get(name)
    if not isinstance(entry, dict):
        rows.append((mark, name, None)); continue
    h5, h5r = window(entry, "five_hour")
    d7, d7r = window(entry, "seven_day")
    rows.append((mark, name, (h5, h5r, d7, d7r, age(entry))))

w = max(len(r[1]) for r in rows + [("", "Profile", None)])
print()
print("Cached quota (offline snapshot, not live — a cached % is a lower bound):")
print(f"  {'Profile':<{w}}  {'5h':>7}  {'resets':>8}  {'7d':>7}  {'resets':>8}  {'sampled':>9}")
for mark, name, data in rows:
    if data is None:
        print(f"{mark} {name:<{w}}  no sample")
    else:
        h5, h5r, d7, d7r, when = data
        print(f"{mark} {name:<{w}}  {h5:>7}  {h5r:>8}  {d7:>7}  {d7r:>8}  {when:>9}")
print(f"* = active profile; refresh with '{hint}'")
PY
}

# Record a rate-limit observation that Claude Code handed us for free.
#
# Claude Code pipes a JSON payload into the configured statusLine command on every
# render, and for Claude.ai subscribers that payload already carries the same two
# rolling windows the `quota` command pays a network request for. Hooking a single
# line onto the end of an existing statusLine script therefore keeps the *active*
# profile's cache continuously fresh at zero cost — and, more usefully, means that
# when you switch away from a profile its last sample is from seconds earlier rather
# than from whenever you last remembered to run `quota`.
#
# Two constraints follow from running inside a status line:
#   - It must never fail loudly. A broken payload, a missing marker, or an unwritable
#     cache all exit quietly; breaking someone's prompt to record telemetry is absurd.
#   - It must not write on every render. Writes are skipped while the values are
#     unchanged and the existing sample is under a minute old.
#
# Attribution note: the payload does not identify the account, so the observation is
# filed under whatever `.active-profile` says. flipauth keeps that marker correct when
# it performs the switch; a login performed outside flipauth can make it stale, and
# there is no account identifier in Claude credentials to cross-check against.
cmd_observe() {
  [[ "$SERVICE" == claude ]] ||
    fail "observe is Claude-only (it consumes a Claude Code statusLine payload); not supported for $SERVICE"
  local payload
  payload="$(cat 2>/dev/null || true)"
  [[ -n "$payload" ]] || return 0
  python3 - "$payload" "$ACTIVE_MARKER" "$QUOTA_CACHE" "$QUOTA_CACHE_SCHEMA" \
           "${OBSERVE_MIN_INTERVAL:-60}" <<'PY' || true
import json, os, pathlib, sys, tempfile
from datetime import datetime, timezone

payload_raw = sys.argv[1]; active_marker = pathlib.Path(sys.argv[2])
cache_path = pathlib.Path(sys.argv[3]); schema = int(sys.argv[4])
min_interval = float(sys.argv[5])

def quit_quietly():
    raise SystemExit(0)

try:
    payload = json.loads(payload_raw)
except Exception:
    quit_quietly()
if not isinstance(payload, dict):
    quit_quietly()

limits = payload.get("rate_limits")
if not isinstance(limits, dict):
    quit_quietly()          # API-key users have no subscription windows

try:
    profile = active_marker.read_text(encoding="utf-8").strip()
except Exception:
    quit_quietly()
if not profile:
    quit_quietly()

now = datetime.now(timezone.utc)

# statusLine reports resets_at as a unix epoch; the usage endpoint reports ISO.
# Normalise to ISO here so one cache never holds two time formats.
def to_iso(value):
    if isinstance(value, bool) or value is None: return None
    if isinstance(value, (int, float)):
        return datetime.fromtimestamp(value, timezone.utc).isoformat(timespec="seconds")
    if isinstance(value, str):
        text = value.strip()
        if not text: return None
        try:
            return datetime.fromtimestamp(float(text), timezone.utc).isoformat(timespec="seconds")
        except ValueError:
            pass
        try:
            dt = datetime.fromisoformat(text)
        except ValueError:
            return None
        return (dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)).isoformat(timespec="seconds")
    return None

# Both sources express utilization on the same 0-100 scale, so the value is copied
# straight across. Allow-listed, like every other cache write.
def window(src):
    if not isinstance(src, dict): return None
    out = {}
    used = src.get("used_percentage")
    if isinstance(used, (int, float)) and not isinstance(used, bool):
        out["utilization"] = used
    resets = to_iso(src.get("resets_at"))
    if resets: out["resets_at"] = resets
    return out or None

entry = {"fetched_at": now.isoformat(timespec="seconds"), "source": "statusline"}
for key, src_key in (("five_hour", "five_hour"), ("seven_day", "seven_day")):
    w = window(limits.get(src_key))
    if w: entry[key] = w
if "five_hour" not in entry and "seven_day" not in entry:
    quit_quietly()

kept = {}
if cache_path.exists():
    try:
        loaded = json.loads(cache_path.read_text(encoding="utf-8"))
        if (isinstance(loaded, dict) and loaded.get("schema") == schema
                and isinstance(loaded.get("profiles"), dict)):
            kept = loaded["profiles"]
    except Exception:
        kept = {}

# Skip the write while nothing has moved and the existing sample is still young.
prev = kept.get(profile)
if isinstance(prev, dict) and prev.get("source") == "statusline":
    same = all(
        (prev.get(k) or {}).get("utilization") == (entry.get(k) or {}).get("utilization")
        for k in ("five_hour", "seven_day"))
    if same:
        try:
            age = (now - datetime.fromisoformat(prev["fetched_at"])).total_seconds()
        except Exception:
            age = min_interval + 1
        if age < min_interval:
            quit_quietly()

kept[profile] = entry
tmp = None
try:
    cache_path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(cache_path.parent), prefix=".quota-cache.")
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump({"schema": schema, "profiles": kept}, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, cache_path); tmp = None
except Exception:
    if tmp:
        try: os.unlink(tmp)
        except OSError: pass
PY
  return 0
}

# Query Anthropic's OAuth usage endpoint for each saved Claude profile and print
# 5-hour / 7-day rolling-window utilization plus reset countdowns. This is the
# only command that makes a network call; everything else is offline file work.
quota_claude() {
  local user_agent api_base want="${1:-}"
  user_agent="$(_claude_user_agent)"
  api_base="${CLAUDE_SWITCH_API_BASE:-https://api.anthropic.com}"
  python3 - "$STATE_DIR" "$ACTIVE_MARKER" "${ACTIVE[0]}" "$user_agent" "$api_base" "$want" \
           "$QUOTA_CACHE" "$QUOTA_CACHE_SCHEMA" <<'PY'
import json, os, pathlib, sys, tempfile, urllib.request, urllib.error
from datetime import datetime, timezone

state_dir = pathlib.Path(sys.argv[1]); active_marker = pathlib.Path(sys.argv[2])
live = pathlib.Path(sys.argv[3]); user_agent = sys.argv[4]
api_base = sys.argv[5].rstrip("/"); want = sys.argv[6]
cache_path = pathlib.Path(sys.argv[7]); cache_schema = int(sys.argv[8])

active = ""
if active_marker.exists():
    try: active = active_marker.read_text(encoding="utf-8").strip()
    except Exception: active = ""

# Collect profiles: name -> credentials path. The active profile uses the live
# file (freshest token); others use their saved snapshot (may be stale/expired).
profiles = {}
if state_dir.exists():
    for p in sorted(state_dir.glob("*.credentials.json")):
        profiles[p.name[: -len(".credentials.json")]] = p
if active and live.exists():
    profiles[active] = live
if want:
    profiles = {k: v for k, v in profiles.items() if k == want}
    if not profiles:
        print(f"no saved profile named {want}"); raise SystemExit(1)
if not profiles:
    print("Saved profiles: none"); raise SystemExit(0)

def token_of(path):
    try:
        oauth = json.loads(path.read_text(encoding="utf-8"))["claudeAiOauth"]
        return oauth.get("accessToken") or ""
    except Exception:
        return ""

def fetch(token):
    req = urllib.request.Request(
        f"{api_base}/api/oauth/usage",
        headers={"Authorization": f"Bearer {token}",
                 "anthropic-beta": "oauth-2025-04-20",
                 "User-Agent": user_agent,
                 "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.loads(r.read().decode("utf-8"))

def rel(iso):
    if not iso: return "—"
    try: dt = datetime.fromisoformat(iso)
    except Exception: return "?"
    if dt.tzinfo is None: dt = dt.replace(tzinfo=timezone.utc)
    secs = (dt - datetime.now(timezone.utc)).total_seconds()
    if secs <= 0: return "due"
    d, rem = divmod(int(secs), 86400); h, rem = divmod(rem, 3600); m = rem // 60
    if d: return f"in {d}d{h}h"
    if h: return f"in {h}h{m:02d}m"
    return f"in {m}m"

def pct(window):
    if not isinstance(window, dict): return "—", ""
    u = window.get("utilization")
    return (f"{u:.0f}%" if isinstance(u, (int, float)) else "—",
            rel(window.get("resets_at")))

# Build the cache entry for one successful response. Strictly allow-listed: only
# the two rolling windows' utilization and reset time, plus when and from which
# credential file the sample came. Tokens and any other response field are dropped.
def sample_of(data, path):
    def win(w):
        if not isinstance(w, dict): return None
        out = {}
        if isinstance(w.get("utilization"), (int, float)): out["utilization"] = w["utilization"]
        if isinstance(w.get("resets_at"), str): out["resets_at"] = w["resets_at"]
        return out or None
    entry = {"fetched_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
             "source": "live" if path == live else "snapshot"}
    for key in ("five_hour", "seven_day"):
        w = win(data.get(key))
        if w: entry[key] = w
    return entry

# Merge successful samples into the cache. Only profiles that answered are
# touched, so a single-profile query never drops the others, and a run where
# every profile failed leaves the last good samples in place.
def write_cache(samples):
    if not samples: return
    kept = {}
    if cache_path.exists():
        try:
            loaded = json.loads(cache_path.read_text(encoding="utf-8"))
            if (isinstance(loaded, dict) and loaded.get("schema") == cache_schema
                    and isinstance(loaded.get("profiles"), dict)):
                kept = loaded["profiles"]
        except Exception:
            kept = {}
    kept.update(samples)
    tmp = None
    try:
        cache_path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=str(cache_path.parent), prefix=".quota-cache.")
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump({"schema": cache_schema, "profiles": kept}, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(tmp, cache_path); tmp = None
    except Exception as exc:
        if tmp:
            try: os.unlink(tmp)
            except OSError: pass
        print(f"note: quota cache not updated ({type(exc).__name__})", file=sys.stderr)

samples = {}
rows = []
for name, path in profiles.items():
    mark = "*" if name == active else " "
    token = token_of(path)
    if not token:
        rows.append((mark, name, "no token", "", "", "")); continue
    try:
        data = fetch(token)
    except urllib.error.HTTPError as e:
        msg = {401: "token expired — re-activate", 403: "forbidden",
               429: "rate limited (retry >180s)"}.get(e.code, f"HTTP {e.code}")
        rows.append((mark, name, msg, "", "", "")); continue
    except Exception as e:
        rows.append((mark, name, f"error: {type(e).__name__}", "", "", "")); continue
    samples[name] = sample_of(data, path)
    h5, h5r = pct(data.get("five_hour"))
    d7, d7r = pct(data.get("seven_day"))
    rows.append((mark, name, h5, h5r, d7, d7r))

write_cache(samples)

w = max(len(r[1]) for r in rows + [("", "Profile", "", "", "", "")])
print(f"  {'Profile':<{w}}  {'5h':>5}  {'resets':>8}  {'7d':>5}  {'resets':>8}")
for mark, name, h5, h5r, d7, d7r in rows:
    if h5r == "" and d7 == "":  # error/status row spans the data columns
        print(f"{mark} {name:<{w}}  {h5}")
    else:
        print(f"{mark} {name:<{w}}  {h5:>5}  {h5r:>8}  {d7:>5}  {d7r:>8}")
print("* = active profile")
PY
}

cmd_quota() {
  [[ "$SERVICE" == claude ]] ||
    fail "quota is Claude-only (Anthropic OAuth usage endpoint); not supported for $SERVICE"
  [[ -n "${1:-}" ]] && validate_profile_name "$1"
  quota_claude "${1:-}"
}

case "${1:-}" in
  save)   [[ "$#" -eq 2 ]] || fail "save requires exactly one profile name"; cmd_save "$2" ;;
  status)
    case "${2:-}" in
      "")     [[ "$#" -eq 1 ]] || fail "status takes no extra arguments"; cmd_status ;;
      --json) [[ "$#" -eq 2 ]] || fail "status --json takes no further arguments"; cmd_status_json ;;
      *)      fail "status takes no arguments other than --json" ;;
    esac ;;
  observe) [[ "$#" -eq 1 ]] || fail "observe takes no arguments"; cmd_observe ;;
  doctor) [[ "$#" -eq 1 ]] || fail "doctor takes no extra arguments"; cmd_doctor ;;
  quota)  [[ "$#" -le 2 ]] || fail "quota takes an optional profile name"; cmd_quota "${2:-}" ;;
  login)  [[ "$#" -ge 2 ]] || fail "login requires a profile name"; p="$2"; shift 2; cmd_login "$p" "$@" ;;
  ""|-h|--help|help) usage ;;
  *)      [[ "$#" -eq 1 ]] || fail "activation takes exactly one profile name"; cmd_activate "$1" ;;
esac
