# Read Codex rolling-window usage for each saved profile.
#
# Codex has no HTTP usage endpoint to call directly; the data lives behind the
# app-server's JSON-RPC method `account/rateLimits/read`. Three properties of that
# protocol make it safe to drive from here, and each one is load-bearing:
#
#   - `CODEX_HOME` relocates the whole config root, so a profile is read from a
#     throwaway copy of its snapshot. Nothing is ever copied back, so a saved profile
#     cannot be mutated by a query, and the live account is never activated.
#   - `account/chatgptAuthTokens/refresh` is a *server->client* request: the app-server
#     does not refresh tokens itself, it asks the connected client to do it and hand the
#     new token back. We decline it, so no token rotation can occur on this path.
#   - Windows are identified by `windowDurationMins`, never by the `primary`/`secondary`
#     field names. Those names are ordinal, not semantic. The current response contains
#     both the 5-hour and 7-day windows, and keying on the field name would silently
#     mislabel them if the backend changes their positions again.
quota_codex() {
  local want="${1:-}" bin
  bin="${CODEX_SWITCH_CODEX_BIN:-codex}"
  command -v "$bin" >/dev/null 2>&1 ||
    fail "codex command not found; set CODEX_SWITCH_CODEX_BIN to its path"
  # Run the reader as a job so a signal aimed at flipauth reaches it. Without this the
  # Python child is merely orphaned: it keeps querying — with a credential copy on disk —
  # after the command the user killed has already exited.
  local pid rc=0
  python3 - "$STATE_DIR" "$ACTIVE_MARKER" "${ACTIVE[0]}" "${ACTIVE[1]}" "$want" \
           "$QUOTA_CACHE" "$QUOTA_CACHE_SCHEMA" "$bin" "${CODEX_SWITCH_QUOTA_TIMEOUT:-40}" <<'PY' &
import json, os, pathlib, shutil, signal, subprocess, sys, tempfile, threading, time
from datetime import datetime, timezone

TEMP_PREFIX = ".codex-quota-"

# A query holds a copy of a real credential in a temp CODEX_HOME for a few seconds. Two
# defences keep that copy from outliving the query:
#   - catch the signals we can, so the `finally` that removes the directory still runs;
#   - sweep anything an uncatchable kill (SIGKILL, power loss) stranded earlier.
# The sweep only touches directories with this exact prefix that we own and that are
# older than a concurrent run could plausibly be.
# Bail out once and once only. A second signal arriving while the cleanup below is
# still running would raise again from inside the `finally` and abort it *before* the
# temp directory is removed — which is exactly the leak this handler exists to prevent.
_bailing = False

def _bail(signum, frame):
    global _bailing
    if _bailing:
        return
    _bailing = True
    raise SystemExit(128 + signum)

for _sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    try: signal.signal(_sig, _bail)
    except (OSError, ValueError, AttributeError): pass

def sweep_stranded(max_age=300):
    try: root = pathlib.Path(tempfile.gettempdir())
    except Exception: return
    now = time.time(); uid = os.getuid()
    for d in root.glob(TEMP_PREFIX + "*"):
        try:
            st = d.stat()
            if d.is_dir() and st.st_uid == uid and now - st.st_mtime > max_age:
                shutil.rmtree(d, ignore_errors=True)
        except OSError:
            pass

sweep_stranded()

state_dir = pathlib.Path(sys.argv[1]); active_marker = pathlib.Path(sys.argv[2])
live_auth = pathlib.Path(sys.argv[3]); live_creds = pathlib.Path(sys.argv[4])
want = sys.argv[5]; cache_path = pathlib.Path(sys.argv[6]); cache_schema = int(sys.argv[7])
codex_bin = sys.argv[8]; timeout = float(sys.argv[9])

active = ""
if active_marker.exists():
    try: active = active_marker.read_text(encoding="utf-8").strip()
    except Exception: active = ""

profiles = {}
if state_dir.exists():
    for p in sorted(state_dir.glob("*.auth.json")):
        name = p.name[: -len(".auth.json")]
        creds = state_dir / f"{name}.credentials.json"
        profiles[name] = (p, creds if creds.exists() else None)
if active and live_auth.exists():
    profiles[active] = (live_auth, live_creds if live_creds.exists() else None)
if want:
    profiles = {k: v for k, v in profiles.items() if k == want}
    if not profiles:
        print(f"no saved profile named {want}"); raise SystemExit(1)
if not profiles:
    print("Saved profiles: none"); raise SystemExit(0)

def read_limits(auth_path, creds_path):
    """Drive one app-server against a throwaway CODEX_HOME. Returns (result, error)."""
    home = pathlib.Path(tempfile.mkdtemp(prefix=TEMP_PREFIX))
    proc = None
    try:
        os.chmod(home, 0o700)
        shutil.copy2(auth_path, home / "auth.json"); os.chmod(home / "auth.json", 0o600)
        if creds_path:
            shutil.copy2(creds_path, home / ".credentials.json")
            os.chmod(home / ".credentials.json", 0o600)
        env = dict(os.environ, CODEX_HOME=str(home))
        env.pop("CODEX_SWITCH_CODEX_DIR", None)
        proc = subprocess.Popen([codex_bin, "app-server", "--stdio"],
                                stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True, bufsize=1, env=env)
        seen, lock = [], threading.Lock()
        def send(msg):
            proc.stdin.write(json.dumps(msg) + "\n"); proc.stdin.flush()
        def pump():
            try:
                for line in proc.stdout:
                    try: msg = json.loads(line)
                    except Exception: continue
                    with lock: seen.append(msg)
                    # Decline the refresh request; never rotate a real token from here.
                    if msg.get("method") == "account/chatgptAuthTokens/refresh" and "id" in msg:
                        try:
                            send({"jsonrpc": "2.0", "id": msg["id"],
                                  "error": {"code": -32000, "message": "flipauth does not refresh tokens"}})
                        except Exception: pass
            except Exception: pass
        threading.Thread(target=pump, daemon=True).start()
        deadline = time.time() + timeout
        def wait(ident):
            while time.time() < deadline:
                with lock:
                    for msg in seen:
                        if msg.get("id") == ident and ("result" in msg or "error" in msg):
                            return msg
                if proc.poll() is not None: return None
                time.sleep(0.05)
            return None
        send({"jsonrpc": "2.0", "id": 1, "method": "initialize",
              "params": {"clientInfo": {"name": "flipauth", "title": "flipauth", "version": "1"},
                         "capabilities": {"experimentalApi": True, "requestAttestation": False}}})
        if wait(1) is None:
            return None, "app-server did not start"
        send({"method": "initialized"})
        send({"jsonrpc": "2.0", "id": 2, "method": "account/rateLimits/read", "params": None})
        reply = wait(2)
        if reply is None:
            return None, "timeout"
        if "error" in reply:
            msg = str(reply["error"].get("message", "error"))
            if "401" in msg or "nauthor" in msg: return None, "token expired — re-login"
            return None, f"error: {msg[:48]}"
        return reply.get("result") or {}, None
    except FileNotFoundError:
        return None, "codex not executable"
    except Exception as exc:
        return None, f"error: {type(exc).__name__}"
    finally:
        if proc is not None:
            try: proc.terminate(); proc.wait(timeout=5)
            except Exception:
                try: proc.kill()
                except Exception: pass
        shutil.rmtree(home, ignore_errors=True)

def label(minutes):
    if not isinstance(minutes, int) or minutes <= 0: return "?"
    if minutes % 1440 == 0: return f"{minutes // 1440}d"
    if minutes % 60 == 0: return f"{minutes // 60}h"
    return f"{minutes}m"

def iso(epoch):
    if not isinstance(epoch, (int, float)) or isinstance(epoch, bool): return None
    return datetime.fromtimestamp(epoch, timezone.utc).isoformat(timespec="seconds")

def rel(epoch):
    if not isinstance(epoch, (int, float)) or isinstance(epoch, bool): return "—"
    secs = epoch - time.time()
    if secs <= 0: return "due"
    d, rem = divmod(int(secs), 86400); h, rem = divmod(rem, 3600); m = rem // 60
    if d: return f"in {d}d{h}h"
    if h: return f"in {h}h{m:02d}m"
    return f"in {m}m"

def rel_iso(text):
    if not isinstance(text, str): return "—"
    try: return rel(datetime.fromisoformat(text).timestamp())
    except ValueError: return "—"

# Allow-list the response into cache-shaped windows. Identity comes from the duration.
def windows_of(snapshot):
    out = []
    if not isinstance(snapshot, dict): return out
    for w in snapshot.values():
        if not isinstance(w, dict): continue
        used = w.get("usedPercent")
        if not isinstance(used, (int, float)) or isinstance(used, bool): continue
        entry = {"utilization": used}
        mins = w.get("windowDurationMins")
        if isinstance(mins, int) and not isinstance(mins, bool):
            entry["duration_minutes"] = mins
        resets = iso(w.get("resetsAt"))
        if resets: entry["resets_at"] = resets
        out.append(entry)
    out.sort(key=lambda e: e.get("duration_minutes") or 0)
    return out

def credits_of(result):
    summary = result.get("rateLimitResetCredits")
    if not isinstance(summary, dict): return None
    count = summary.get("availableCount")
    if not isinstance(count, int) or isinstance(count, bool): return None
    out = {"available": count}
    rows = summary.get("credits")
    if isinstance(rows, list):
        expiries = [r.get("expiresAt") for r in rows
                    if isinstance(r, dict) and isinstance(r.get("expiresAt"), int)
                    and r.get("status") == "available"]
        if expiries:
            out["expires_at"] = iso(min(expiries))
    return out

samples, rows = {}, []
for name, (auth_path, creds_path) in profiles.items():
    mark = "*" if name == active else " "
    result, err = read_limits(auth_path, creds_path)
    if err:
        rows.append((mark, name, err, None)); continue
    snapshot = result.get("rateLimits") if isinstance(result, dict) else None
    wins = windows_of(snapshot)
    if not wins:
        rows.append((mark, name, "no window reported", None)); continue
    entry = {"fetched_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
             "source": "live" if auth_path == live_auth else "snapshot",
             "windows": wins}
    plan = snapshot.get("planType") if isinstance(snapshot, dict) else None
    if isinstance(plan, str): entry["plan_type"] = plan
    creds = credits_of(result)
    if creds: entry["reset_credits"] = creds
    samples[name] = entry
    rows.append((mark, name, None, (wins, creds)))

def write_cache(new):
    if not new: return
    kept = {}
    if cache_path.exists():
        try:
            loaded = json.loads(cache_path.read_text(encoding="utf-8"))
            if (isinstance(loaded, dict) and loaded.get("schema") == cache_schema
                    and isinstance(loaded.get("profiles"), dict)):
                kept = loaded["profiles"]
        except Exception:
            kept = {}
    kept.update(new)
    tmp = None
    try:
        cache_path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=str(cache_path.parent), prefix=".quota-cache.")
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump({"schema": cache_schema, "profiles": kept}, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(tmp, cache_path); tmp = None
    except Exception as exc:
        if tmp:
            try: os.unlink(tmp)
            except OSError: pass
        print(f"note: quota cache not updated ({type(exc).__name__})", file=sys.stderr)

write_cache(samples)

flat = []
for mark, name, err, data in rows:
    if err: flat.append((mark, name, err, "", ""))
    else:
        wins, _creds = data
        for w in wins:
            flat.append((mark, name, label(w.get("duration_minutes")),
                         f"{w['utilization']:.0f}%", rel_iso(w.get("resets_at"))))
            mark, name = " ", ""

w_name = max([len(r[1]) for r in flat] + [len("Profile")])
print(f"  {'Profile':<{w_name}}  {'window':>6}  {'used':>6}  {'resets':>9}")
for mark, name, a, b, c in flat:
    if b == "" and c == "":
        print(f"{mark} {name:<{w_name}}  {a}")
    else:
        print(f"{mark} {name:<{w_name}}  {a:>6}  {b:>6}  {c:>9}")
print("* = active profile")

# The expiry is a deadline the operator acts on, so show it in local time. The cache
# keeps UTC; rendering the UTC date here would be off by a day in eastern time zones.
def local_date(iso_text):
    if not isinstance(iso_text, str): return None
    try: dt = datetime.fromisoformat(iso_text)
    except ValueError: return None
    if dt.tzinfo is None: dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone().strftime("%Y-%m-%d")

for _m, name, _e, data in rows:
    if data and data[1]:
        creds = data[1]
        when = local_date(creds.get("expires_at"))
        tail = f" (expires {when})" if when else ""
        print(f"Reset credits for {name}: {creds['available']} available{tail}")
PY
  pid=$!
  trap "kill -TERM $pid 2>/dev/null" TERM INT HUP
  wait "$pid" || rc=$?
  trap - TERM INT HUP
  return "$rc"
}

cmd_quota() {
  [[ -n "${1:-}" ]] && validate_profile_name "$1"
  if [[ "$SERVICE" == claude ]]; then quota_claude "${1:-}"; else quota_codex "${1:-}"; fi
}

case "${1:-}" in
  save)   [[ "$#" -eq 2 ]] || fail "save requires exactly one profile name"; cmd_save "$2" ;;
  status)
    case "${2:-}" in
      "")     [[ "$#" -eq 1 ]] || fail "status takes no extra arguments"; cmd_status ;;
      --json) [[ "$#" -eq 2 ]] || fail "status --json takes no further arguments"; cmd_status_json ;;
      *)      fail "status takes no arguments other than --json" ;;
    esac ;;
  observe) [[ "$#" -eq 1 ]] || fail "observe takes no arguments"; cmd_observe ;;
  doctor) [[ "$#" -eq 1 ]] || fail "doctor takes no extra arguments"; cmd_doctor ;;
  quota)  [[ "$#" -le 2 ]] || fail "quota takes an optional profile name"; cmd_quota "${2:-}" ;;
  login)  [[ "$#" -ge 2 ]] || fail "login requires a profile name"; p="$2"; shift 2; cmd_login "$p" "$@" ;;
  ""|-h|--help|help) usage ;;
  *)      [[ "$#" -eq 1 ]] || fail "activation takes exactly one profile name"; cmd_activate "$1" ;;
esac
