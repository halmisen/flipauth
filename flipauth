# Resolve the Windows-side Codex auth path.
# Priority: CODEX_SWITCH_WINDOWS_AUTH env var > wslvar/wslpath detection > empty.
_resolve_windows_auth() {
  # If the variable is set (even to empty), use its value and skip auto-detection.
  # Empty value = explicitly disabled; non-empty = explicit path override.
  if [[ "${CODEX_SWITCH_WINDOWS_AUTH+set}" == set ]]; then
    printf '%s' "${CODEX_SWITCH_WINDOWS_AUTH}"
    return
  fi
  # Try wslvar (part of wslu package)
  local userprofile wsl_path
  if userprofile="$(wslvar USERPROFILE 2>/dev/null)" && [[ -n "$userprofile" ]]; then
    if wsl_path="$(wslpath "$userprofile" 2>/dev/null)" && [[ -n "$wsl_path" ]]; then
      printf '%s/.codex/auth.json' "$wsl_path"
      return
    fi
  fi
  # Try cmd.exe as fallback
  if userprofile="$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r\n')" && [[ -n "$userprofile" && "$userprofile" != '%USERPROFILE%' ]]; then
    if wsl_path="$(wslpath "$userprofile" 2>/dev/null)" && [[ -n "$wsl_path" ]]; then
      printf '%s/.codex/auth.json' "$wsl_path"
      return
    fi
  fi
  printf ''
}

